	partition consumo_15min = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\consumo_15min.csv"), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"inicio", type datetime}, {"fin", type datetime}, {"activa_kwh", type number}, {"reactiva_ind_kvarh", type number}, {"reactiva_cap_kvarh", type number}, {"fecha", type date}, {"mes", Int64.Type}, {"hora", Int64.Type}, {"temporada", type text}, {"tipo_dia", type text}, {"periodo", type text}}, "en-US"),
				    Meses = Table.AddColumn(Typed, "mes_nombre", each {"Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"}{[mes] - 1}, type text)
				in
				    Meses

	annotation PBI_ResultType = Table

