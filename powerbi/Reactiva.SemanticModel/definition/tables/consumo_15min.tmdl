table consumo_15min
	lineageTag: 32e5c98d-3cc0-51d9-8f53-ac285711e7ca

	measure 'Potencia media kW' = AVERAGE(consumo_15min[activa_kwh]) * 4
		formatString: #,0
		lineageTag: 2fdd3090-4408-5737-ae71-ddda20aa0f6c

	measure 'Inductiva kVAr medios' = AVERAGE(consumo_15min[reactiva_ind_kvarh]) * 4
		formatString: #,0
		lineageTag: 5a3a574e-8855-5414-b03e-d197a51ff299

	measure 'Capacitiva kVAr medios' = AVERAGE(consumo_15min[reactiva_cap_kvarh]) * 4
		formatString: #,0
		lineageTag: 3f22eb37-0675-50e1-97e7-cac638a34a6d

	column inicio
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
