table factura_mensual
	lineageTag: b243dad8-ecd2-5871-9416-cff6fd3227a7

	measure 'Coste actual €' = SUM(factura_mensual[coste_ind_eur])
		formatString: #,0 €
		lineageTag: 5ab965f9-4984-510e-8a32-077db95f506d

	measure 'Coste con 50 kVAr €' = SUM(factura_mensual[coste_ind_50])
		formatString: #,0 €
		lineageTag: ae111b6d-4f0f-5150-8a55-b1c9a44616de

	measure 'Coste con 100 kVAr €' = SUM(factura_mensual[coste_ind_100])
		formatString: #,0 €
		lineageTag: 2cd36b77-ceb7-590e-974a-73d698526247

	measure 'Coste con 150 kVAr €' = SUM(factura_mensual[coste_ind_150])
		formatString: #,0 €
		lineageTag: dbc00fa3-e3e0-520d-8250-ac26e4ad422d

	measure 'Ahorro con 100 kVAr €' = [Coste actual €] - [Coste con 100 kVAr €]
		formatString: #,0 €
		lineageTag: 99c157a3-1a5c-5bd1-b9d7-41fdac93279e

	measure 'Energía activa MWh' = SUM(factura_mensual[activa_kwh]) / 1000
		formatString: #,0
		lineageTag: 017edfd9-7fb1-5885-b1dd-59faba1d5df4

	measure 'Horas P6 que incumplen 0,98' = SUM(factura_mensual[horas_incumple_cap])
		formatString: #,0
		lineageTag: 449e3586-d01c-5096-ac5d-2588a80af57b

	measure 'cos φ actual' = AVERAGE(factura_mensual[cos_phi_ind])
		formatString: 0.000
		lineageTag: e6648db7-d1c6-5606-874f-b4c784863993

	measure 'cos φ con 50 kVAr' = AVERAGE(factura_mensual[cos_phi_ind_50])
		formatString: 0.000
		lineageTag: 537852a3-e435-5378-9b26-9da9cdabc79d

	measure 'cos φ con 100 kVAr' = AVERAGE(factura_mensual[cos_phi_ind_100])
		formatString: 0.000
		lineageTag: ff0c970b-86a9-52b3-8108-f79db64d1074

	measure 'cos φ con 150 kVAr' = AVERAGE(factura_mensual[cos_phi_ind_150])
		formatString: 0.000
		lineageTag: 537237d9-88e6-5fa2-8775-22fb92552831

	measure 'Color cos φ' = VAR c = [cos φ actual] RETURN IF(ISBLANK(c), BLANK(), IF(c >= 0.95, "#CDEBD3", IF(c >= 0.80, "#FFE4A3", "#F6B3AE")))
		lineageTag: e2d30836-246c-5787-b67f-482ff99254b2

