	partition factura_mensual = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\factura_mensual.csv"), [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"mes", Int64.Type}, {"periodo", type text}, {"activa_kwh", type number}, {"reactiva_ind_kvarh", type number}, {"cos_phi_ind", type number}, {"exceso_ind_kvarh", type number}, {"precio_ind_eur_kvarh", type number}, {"coste_ind_eur", type number}, {"horas_incumple_cap", Int64.Type}, {"exceso_cap_kvarh", type number}, {"coste_cap_eur", type number}, {"cos_phi_ind_50", type number}, {"coste_ind_50", type number}, {"cos_phi_ind_100", type number}, {"coste_ind_100", type number}, {"cos_phi_ind_150", type number}, {"coste_ind_150", type number}}, "en-US"),
				    Meses = Table.AddColumn(Typed, "mes_nombre", each {"Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"}{[mes] - 1}, type text)
				in
				    Meses

	annotation PBI_ResultType = Table

